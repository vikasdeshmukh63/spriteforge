{
  "name": "spriteforge",
  "author": "vikas deshmukh vikasdeshmukh63@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikasdeshmukh63/spriteforge.git"
  },
  "homepage": "https://github.com/vikasdeshmukh63/spriteforge#readme",
  "bugs": {
    "url": "https://github.com/vikasdeshmukh63/spriteforge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "description": "Prompt in, game-ready sprite sheets out. Dresses a base-body sprite template and builds tilesets with Google Gemini image generation.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "spriteforge": "bin/spriteforge.js"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "template",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test",
    "build:template": "node scripts/build-template.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "sprite",
    "spritesheet",
    "pixel-art",
    "gemini",
    "game-assets",
    "tileset"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "sharp": "^0.35.5"
  }
}
